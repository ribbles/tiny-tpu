---
import Layout from "@/layouts/Layout.astro";
import WasmSmokeTest from "@/components/WasmSmokeTest";
import "@/styles/global.css";
---

<Layout
  title="WASM Smoke Test - TinyTPU"
  description="Verifies the WASM-compiled RTL produces the correct matmul result in the browser."
>
  <main class="min-h-screen flex flex-col items-center justify-center gap-6 px-4 py-12">
    <header class="text-center space-y-2">
      <h1 class="text-2xl font-bold tracking-tight">
        Tiny<span class="text-primary">TPU</span>
        <span class="text-muted-foreground font-normal"> / smoke</span>
      </h1>
      <p class="text-sm text-muted-foreground max-w-sm">
        Loads <code class="text-foreground">/tiny_tpu.wasm</code>, runs one matmul on the real RTL,
        verifies the result against the numpy golden model.
      </p>
    </header>

    <div class="w-full max-w-2xl">
      <WasmSmokeTest client:only="react" />
    </div>

    <footer class="text-xs text-muted-foreground">
      <a href="/" class="hover:text-foreground transition-colors">← back to home</a>
    </footer>
  </main>
</Layout>
