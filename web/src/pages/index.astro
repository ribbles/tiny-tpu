---
import Layout from "@/layouts/Layout.astro";
import ButtonTest from "@/components/ButtonTest";
import "@/styles/global.css";
---

<Layout title="TinyTPU — A TPU You Can Watch Run">
  <main class="min-h-screen flex flex-col items-center justify-center gap-8 px-6">
    <header class="text-center space-y-3">
      <h1 class="text-4xl font-bold tracking-tight text-foreground">
        Tiny<span class="text-primary">TPU</span>
      </h1>
      <p class="text-muted-foreground max-w-md">
        A 4×4 weight-stationary systolic array in real synthesizable SystemVerilog — compiled to
        WASM, visualized live.
      </p>
    </header>

    <section class="space-y-2 text-center">
      <p class="text-xs text-muted-foreground uppercase tracking-widest">shadcn/ui test</p>
      <ButtonTest client:only="react" />
    </section>

    <section class="grid grid-cols-2 gap-3 text-xs">
      <div class="rounded-lg border border-border bg-card p-3 text-card-foreground">
        <span
          class="inline-block h-3 w-3 rounded-sm mr-2"
          style="background: var(--pe-idle);"
        ></span>Idle
      </div>
      <div class="rounded-lg border border-border bg-card p-3 text-card-foreground">
        <span
          class="inline-block h-3 w-3 rounded-sm mr-2"
          style="background: var(--pe-active);"
        ></span>Active (MAC)
      </div>
      <div class="rounded-lg border border-border bg-card p-3 text-card-foreground">
        <span
          class="inline-block h-3 w-3 rounded-sm mr-2"
          style="background: var(--pe-weight-loaded);"
        ></span>Weight Loaded
      </div>
      <div class="rounded-lg border border-border bg-card p-3 text-card-foreground">
        <span
          class="inline-block h-3 w-3 rounded-sm mr-2"
          style="background: var(--pe-result);"
        ></span>Result Valid
      </div>
    </section>
  </main>
</Layout>
