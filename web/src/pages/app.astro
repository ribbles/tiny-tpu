---
import Layout from "@/layouts/Layout.astro";
import Visualizer from "@/components/Visualizer";
import "@/styles/global.css";
---

<Layout
  title="TinyTPU — Live Systolic Array"
  description="Watch a 4×4 weight-stationary systolic array execute a matrix multiply in real time — compiled from real SystemVerilog RTL to WASM."
>
  <main class="min-h-screen flex flex-col items-center gap-6 px-4 py-10">
    <header class="text-center space-y-1.5 max-w-lg">
      <h1 class="text-3xl font-bold tracking-tight">
        Tiny<span class="text-primary">TPU</span>
      </h1>
      <p class="text-sm text-muted-foreground">
        4×4 weight-stationary systolic array · real RTL compiled to WASM · every
        value is from actual hardware
      </p>
    </header>

    <div class="w-full max-w-2xl">
      <Visualizer client:only="react" />
    </div>

    <footer class="flex items-center gap-4 text-xs text-muted-foreground">
      <a href="/smoke" class="hover:text-foreground transition-colors">smoke test</a>
      <span>·</span>
      <a href="/pe-grid-test" class="hover:text-foreground transition-colors">PE grid test</a>
      <span>·</span>
      <a href="/" class="hover:text-foreground transition-colors">home</a>
    </footer>
  </main>
</Layout>
